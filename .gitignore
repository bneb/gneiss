# ==============================================================================
# Gneiss — Git Ignore Configuration
# ==============================================================================

# --- Rust & Cargo Build Artifacts ---
**/target/
**/*.rs.bk
*.orig
*.rej
Cargo.lock.back

# --- Coverage, Profiling & Mutation Testing ---
*.profraw
*.profdata
coverage/
cobertura.xml
mutants*
doppler_out*

# --- GNSS Data & Ephemeris Products (Large / External Downloads) ---
/datasets/**
!/datasets/README.md
!/datasets/**/README.md
*.rnx
*.crx
*.obs
*.nav
*.sp3
*.clk
*.atx
*.blq
*.ionex
*.snx
*.rtcm3

# --- Solution Dumps, Logs & Benchmark Outputs ---
*.log
*.pos
*.nmea
*.kml
*.geojson
*.pid
log*.txt
bench_output.txt
test_log.txt
trace_log*.txt
eval_*_errors.csv
sweep_*

# --- Archives & Compressed Stores ---
*.tar.gz
*.tar.bz2
*.tar.xz
*.zip
*.7z

# --- Python Environment & Bytecode (Analysis & Sweeps) ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/

# --- Scratch, Diagnostics & Worktrees ---
scratch/
!scratch/README.md
.worktrees/
.licenses/
.env

# --- OS & Editor Artifacts ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
.claude/

# --- Debug / alternate build directories (beyond **/target/) ---
target_*/

# --- Compressed GNSS product downloads (sp3.gz, bia.gz, obs.Z, etc.) ---
*.gz
*.Z

# --- Patch/diff scratch files ---
*.diff
*.patch

# --- Mutation testing outputs not caught by the mutants* prefix rule ---
*mutants*.txt
*mutants*.json
mutants.out*/

# --- Credential / session files ---
.urs_cookies
.netrc
cookie.txt
*.cookies

# --- Unexplained large generated state file (repeatedly seen as repo bloat) ---
.stat

# --- Root-level one-off scripts, scratch source, and text dumps ---
# Real, maintained tooling lives in scripts/; real crate source lives under
# crates/, bin/, tests/. Anything loose at repo root is a one-off dev script
# or a debug dump and should never be committed from here again.
/*.py
/*.sh
/*.rs
/*.txt
/tmp*
