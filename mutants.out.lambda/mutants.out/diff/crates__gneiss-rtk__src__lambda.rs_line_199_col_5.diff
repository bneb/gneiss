 pub fn bootstrapping_success_rate(d: &DVector<f64>) -> f64 {
     let mut ps = 1.0;
     for &di in d.as_slice() {
         if di <= 0.0 { continue; }
         let x = 1.0 / (2.0 * f64::sqrt(di));
         ps *= libm::erf(x / std::f64::consts::SQRT_2);
