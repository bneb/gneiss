 pub fn remove_measurement(z: &mut DVector<f64>, h: &mut DMatrix<f64>, r: &mut DMatrix<f64>, valid: &mut Vec<usize>, idx: usize) {
     *z = z.clone().remove_row(idx);
     *h = h.clone().remove_row(idx);
     *r = r.clone().remove_row(idx).remove_column(idx);
     valid.remove(idx);
 }
